<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RidgeTrainKit</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ridge-train</ToolCommandName>
    <PackageId>RidgeTrainKit.Tool</PackageId>
    <Version>0.1.0</Version>
    <Authors>alirezaRanjbar4</Authors>
    <Description>Small CPU numeric ridge-regression training and batch prediction with portable JSON models and no runtime package dependency.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alirezaRanjbar4/ridge-train-kit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alirezaRanjbar4/ridge-train-kit</PackageProjectUrl>
    <PackageTags>csharp;dotnet;machine-learning;regression;ridge;training</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md;../../LICENSE;../../CONTRIBUTING.md;../../ROADMAP.md;../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../examples/*.jsonl;../../examples/*.json;../../examples/README.md" Pack="true" PackagePath="examples/" />
    <None Include="../../examples/StandaloneScorer/*.*" Exclude="../../examples/StandaloneScorer/obj/**/*;../../examples/StandaloneScorer/bin/**/*" Pack="true" PackagePath="examples/StandaloneScorer/" />
  </ItemGroup>
</Project>
